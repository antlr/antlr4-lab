<configuration>
    <!--
      Local modifications (Michele Fadda, 2026):
      - LOG_DIR is now configurable via -Dantlrlab.log.dir system property;
        defaults to /tmp/antlrlab instead of /var/log/antlrlab (no root needed).
      - fileNamePattern uses LOG_DIR instead of the undefined LOG_FILE variable.
      - Added missing STDOUT console appender definition.
    -->
    <property name="LOG_DIR" value="${antlrlab.log.dir:-/tmp/antlrlab}" />
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_DIR}/antlrlab.log</file>
        <append>true</append>
        <rollingPolicy class="ch.qos.logback.core.rolling.TimeBasedRollingPolicy">
            <!-- daily rollover -->
            <fileNamePattern>${LOG_DIR}/antlrlab.%d{yyyy-MM-dd}.gz</fileNamePattern>
            <!-- keep 30 days' worth of history capped at 3GB total size -->
            <maxHistory>30</maxHistory>
            <totalSizeCap>3GB</totalSizeCap>
        </rollingPolicy>
        <encoder>
            <pattern>%date{yyyy-MMM-dd; HH:mm:ss.SSS} [%thread]:%n%msg%n</pattern>
        </encoder>
    </appender>
    <appender name="STDOUT" class="ch.qos.logback.core.ConsoleAppender">
        <encoder>
            <pattern>%d{HH:mm:ss.SSS} [%thread] %-5level %logger{36} - %msg%n</pattern>
        </encoder>
    </appender>
    <logger name="org.antlr.v4.server.ANTLRHttpServer" level="INFO">
        <appender-ref ref="FILE"/>
    </logger>

    <root level="ERROR">
        <appender-ref ref="STDOUT" />
    </root>
</configuration>